+def compute_answer_token_uncertainty(logprobs_steps, start_idx: int, end_idx: int) -> Dict:
+    """Per-answer-token uncertainty from vLLM top-K logprobs.
+
+    Entropy is renormalized over the returned top-K (approximation when K << |V|).
+    Margin is top1_logprob - top2_logprob among returned candidates.
+
+    Aggregates:
+      U_tail = 90th percentile of token entropies (high = uncertain)
+      M_tail = 10th percentile of token margins (low = uncertain)
+    """
+    ents: List[float] = []
+    margins: List[float] = []
+    top1_probs: List[float] = []
+    if start_idx >= end_idx or not logprobs_steps:
+        return {
+            "answer_token_entropies": ents,
+            "answer_token_margins": margins,
+            "answer_token_top1_probs": top1_probs,
+            "U_tail": None,
+            "M_tail": None,
+            "mean_entropy": None,
+            "min_margin": None,
+        }
+
+    lo = max(0, start_idx)
+    hi = min(end_idx, len(logprobs_steps))
+    for pos in range(lo, hi):
+        lps = sorted(_step_logprob_values(logprobs_steps[pos]), reverse=True)
+        if not lps:
+            continue
+        max_lp = lps[0]
+        exps = [math.exp(lp - max_lp) for lp in lps]
+        Z = sum(exps) or 1.0
+        ps = [e / Z for e in exps]
+        H = -sum(p * math.log(max(p, 1e-12)) for p in ps)
+        margin = (lps[0] - lps[1]) if len(lps) >= 2 else 0.0
+        ents.append(float(H))
+        margins.append(float(margin))
