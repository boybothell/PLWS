+def _step_logprob_values(step) -> List[float]:
+    """All available logprobs at one generation step (chosen + top-K)."""
+    if isinstance(step, float):
+        return [step]
+    if not isinstance(step, dict) or not step:
+        try:
+            return [float(step)]
+        except Exception:
+            return [0.0]
+    out = []
+    for val in step.values():
+        if hasattr(val, "logprob"):
+            out.append(float(val.logprob))
+        else:
+            try:
+                out.append(float(val))
+            except Exception:
+                continue
+    return out or [0.0]
