+def probe_ended_with_think_close(completion_output) -> bool:
+    """Version-tolerant implementation of Qwen3's DEER safety gate."""
+
+    if str(getattr(completion_output, "stop_reason", "") or "") == "</think>":
+        return True
+    for token_logprobs in reversed(completion_output.logprobs or []):
+        for item in token_logprobs.values():
+            if getattr(item, "decoded_token", None) == "</think>":
+                return True
+        if token_logprobs:
+            break
+    return "</think>" in str(getattr(completion_output, "text", ""))
+
