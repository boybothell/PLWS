diff --git a/baselines/deer/canonical_protocol.py b/baselines/deer/canonical_protocol.py
new file mode 100644
index 0000000..82c866d
--- /dev/null
+++ b/baselines/deer/canonical_protocol.py
@@ -0,0 +1,62 @@
+"""Pure helpers for DEER under the canonical Full-CoT host protocol."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+PROTOCOL_ID = "puma-fullcot-32k-v2"
+FULLCOT_GENERATION_TOKENS = 32768
+PROMPT_RESERVE_TOKENS = 3072
+TRUNCATED_ANSWER_FIX_TOKENS = 2048
+CANONICAL_MAX_MODEL_LEN = 37888
+
+
+@dataclass(frozen=True, slots=True)
+class DeerFamilyPolicy:
+    name: str
+    think_ratio: float
+    confidence_policy: str
+    require_probe_think_close: bool
+
+
+def policy_for_model(model_name: str) -> DeerFamilyPolicy:
+    """Return DEER's model-family-specific internal control policy."""
+
+    model_lower = model_name.lower()
+    if "qwen3" in model_lower:
+        return DeerFamilyPolicy(
+            name="qwen3",
+            think_ratio=0.8,
+            confidence_policy="avg2",
+            require_probe_think_close=True,
+        )
+    return DeerFamilyPolicy(
+        name="standard",
+        think_ratio=0.6,
+        confidence_policy="avg1",
+        require_probe_think_close=False,
+    )
+
+
+def probe_gate_passed(
+    policy: DeerFamilyPolicy,
+    *,
+    probe_think_closed: bool,
+) -> bool:
+    return not policy.require_probe_think_close or probe_think_closed
+
+
+def answer_budget(
+    *,
+    delivered_thinking_tokens: int,
+    host_answer_fix: bool,
+    context_room: int,
+) -> tuple[int, int]:
+    """Return (requested, usable) answer tokens for one DEER delivery."""
+
+    requested = (
+        TRUNCATED_ANSWER_FIX_TOKENS
+        if host_answer_fix
+        else max(0, FULLCOT_GENERATION_TOKENS - delivered_thinking_tokens)
+    )
+    return requested, max(0, min(requested, context_room))
diff --git a/puma/vllm_shutdown.py b/puma/vllm_shutdown.py
new file mode 100644
index 0000000..ea465b1
--- /dev/null
+++ b/puma/vllm_shutdown.py
@@ -0,0 +1,25 @@
+"""Release a vLLM engine before CPU-only postprocess."""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+
+def shutdown_llm(llm: Any) -> None:
+    """Drop the vLLM engine. Safe to call twice or on a dummy object."""
+    if llm is None or getattr(llm, "_trial_shutdown_done", False):
+        return
+    engine = getattr(llm, "llm_engine", None)
+    client = getattr(engine, "engine_core", None)
+    shutdown = getattr(client, "shutdown", None)
+    if not callable(shutdown):
+        return
+    llm._trial_shutdown_done = True
+    logger.info("Shutting down vLLM engine to release GPU before CPU postprocess")
+    try:
+        shutdown(timeout=10)
+    except Exception:
+        logger.exception("vLLM shutdown failed")
