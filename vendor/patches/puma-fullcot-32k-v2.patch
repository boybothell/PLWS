+            "answer_token_margins": margins,
+            "answer_token_top1_probs": top1_probs,
+            "U_tail": None,
+            "M_tail": None,
+            "mean_entropy": None,
+            "min_margin": None,
+        }
+
+    ents_s = sorted(ents)
+    margins_s = sorted(margins)
+    # nearest-rank percentiles
+    def pct(arr: List[float], q: float) -> float:
+        if len(arr) == 1:
+            return arr[0]
+        idx = min(len(arr) - 1, max(0, int(math.ceil(q * len(arr)) - 1)))
+        return arr[idx]
+
+    return {
+        "answer_token_entropies": ents,
+        "answer_token_margins": margins,
+        "answer_token_top1_probs": top1_probs,
+        "U_tail": float(pct(ents_s, 0.90)),
+        "M_tail": float(pct(margins_s, 0.10)),
+        "mean_entropy": float(sum(ents) / len(ents)),
